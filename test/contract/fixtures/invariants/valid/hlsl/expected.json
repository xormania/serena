{
  "backend": "hlsl",
  "must_equal": {
    "backends.hlsl.provisioning.strategy": "download",
    "backends.hlsl.platforms.provisioningOverrides.macos.strategy": "source-build",
    "backends.hlsl.platforms.provisioningOverrides.macos.lockDiscipline.flag": "--locked",
    "extracted.servers.hlsl_language_server.cargoCommands.0": [
      "cargo",
      "install",
      "shader_language_server",
      "--version",
      "version",
      "--locked",
      "--root",
      "."
    ]
  }
}
